import os ;
import path ;

path-constant CWD : . ;
path-constant TPL_PATH : ../../../3rd ;

local BOOST_ROOT = [ os.environ BOOST_ROOT ] ;
if ! $(BOOST_ROOT)
{
    BOOST_ROOT = $(TPL_PATH)/boost_1_62_0 ;
}
ECHO "Boost lib path is: " $(BOOST_ROOT) ;
# 强制其他模块都使用一致的Boost版本
modules.poke : BOOST_ROOT : $(BOOST_ROOT) ;

use-project /boost : $(BOOST_ROOT) ;
use-project /adk : ../../ ;

alias dependencies
    : /boost/log//boost_log
      /boost/log//boost_log_setup
      /boost/locale//boost_locale
      /boost/thread//boost_thread
      /boost/filesystem//boost_filesystem
    ;

lib pcap
    :
    : <name>pcap
      <search>$(CWD)/lib64/
      <link>shared
    :
    : <include>$(CWD)/include
    ;
	
exe pcap_raw_packet_cap
    : pcap_raw_packet_cap.cpp
      /adk
      dependencies
      pcap
    : <cxxflags>-g3
      <threading>multi
      <implicit-dependency>/boost//headers
      <debug-symbols>on
    : 
    ;
	
exe rdma_raw_packet_cap
    : rdma_raw_packet_cap.cpp
      /adk
      dependencies
    : <cxxflags>-g3
      <threading>multi
      <implicit-dependency>/boost//headers
      <debug-symbols>on
    : 
    ;

exe exa_raw_packet_cap
    : exa_raw_packet_cap.cpp
      /adk
      dependencies
    : <cxxflags>-g3
      <threading>multi
      <implicit-dependency>/boost//headers
      <debug-symbols>on
    : 
    ;

exe sock_server
    : socket_server.cpp
	  /adk
	  dependencies
    : <cxxflags>-g3
      <threading>multi
	  <implicit-dependency>/boost//headers
      <debug-symbols>on
    : 
    ;

exe sock_client
    : socket_cli.cpp
	  /adk
	  dependencies
    : <cxxflags>-g3
      <threading>multi
	  <implicit-dependency>/boost//headers
      <debug-symbols>on
    : 
    ;