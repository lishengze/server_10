actions translate
{
    mv translate.po old.po
    xgettext -C --no-wrap \
        -kADK_LOG_TRACE_AC_TF:1,\"log\ title\" \
        -kADK_LOG_DEBUG_AC_TF:1,\"log\ title\" \
        -kADK_LOG_INFO_AC_TF:1,\"log\ title\" \
        -kADK_LOG_WARN_AC_TF:1,\"log\ title\" \
        -kADK_LOG_ERROR_AC_TF:1,\"log\ title\" \
        -kADK_LOG_FATAL_AC_TF:1,\"log\ title\" \
        -kADK_LOG_TRACE_TF:2,\"log\ title\" \
        -kADK_LOG_DEBUG_TF:2,\"log\ title\" \
        -kADK_LOG_INFO_TF:2,\"log\ title\" \
        -kADK_LOG_WARN_TF:2,\"log\ title\" \
        -kADK_LOG_ERROR_TF:2,\"log\ title\" \
        -kADK_LOG_FATAL_TF:2,\"log\ title\" \
        -kADK_TRANSLATE \
        test_log.cpp -o title.pot
    msginit -i title.pot -l zh_CN.UTF-8 --no-translator -o title.po
    xgettext -C --no-wrap \
        -kADK_LOG_TRACE_AC_TF:2,\"log\ message\" \
        -kADK_LOG_DEBUG_AC_TF:2,\"log\ message\" \
        -kADK_LOG_INFO_AC_TF:2,\"log\ message\" \
        -kADK_LOG_WARN_AC_TF:2,\"log\ message\" \
        -kADK_LOG_ERROR_AC_TF:2,\"log\ message\" \
        -kADK_LOG_FATAL_AC_TF:2,\"log\ message\" \
        -kADK_LOG_TRACE_TF:3,\"log\ message\" \
        -kADK_LOG_DEBUG_TF:3,\"log\ message\" \
        -kADK_LOG_INFO_TF:3,\"log\ message\" \
        -kADK_LOG_WARN_TF:3,\"log\ message\" \
        -kADK_LOG_ERROR_TF:3,\"log\ message\" \
        -kADK_LOG_FATAL_TF:3,\"log\ message\" \
        test_log.cpp -o message.pot
    msginit -i message.pot -l zh_CN.UTF-8 --no-translator --no-wrap -o message.po
    msgcat --no-wrap -F title.po message.po -o translate.po
    msgmerge --no-wrap old.po translate.po -o translate.po
    mkdir zh_CN
    mkdir zh_CN/LC_MESSAGES
    msgfmt translate.po -o zh_CN/LC_MESSAGES/translate.mo
    export TRANSLATE_PATH=$(CWD)
}

make $(CWD)/zh_CN/LC_MESSAGES/translate.mo
    : test_log.cpp
      translate.po
    : translate ;

exe test_log
    : test_log.cpp
      ..//adk
    : <include>../
      <threading>multi
      <implicit-dependency>/boost//headers
      <debug-symbols>on
      <define>ADK_LOG_USE_BOOST_LOG
      <dependency>$(CWD)/zh_CN/LC_MESSAGES/translate.mo
    : <include>../
    ;

