    : test_lock_free_queue_variant.cpp
      ..//adk/<variant>adk_pack
    : <include>../
      <threading>multi
      <implicit-dependency>/boost//headers
      <debug-symbols>on
      <variant>spsc:<define>SPSC_TEST
      <variant>mpmc:<define>MPMC_TEST
      <variant>mpsc:<define>UNBOUNDED_MPSC
      <variant>debug:<define>MPMC_TEST  # default: MPMC_TEST
      <variant>release:<define>MPMC_TEST
    : <include>../
    ;
	
