import os ;
import path ;

path-constant CWD : . ;
path-constant TPL_PATH : ../../../../3rd ;

local BOOST_ROOT = [ os.environ BOOST_ROOT ] ;
if ! $(BOOST_ROOT)
{
    BOOST_ROOT = $(TPL_PATH)/boost_1_62_0 ;
}
ECHO "Boost lib path is: " $(BOOST_ROOT) ;
# 强制其他模块都使用一致的Boost版本
modules.poke : BOOST_ROOT : $(BOOST_ROOT) ;

use-project /boost : $(BOOST_ROOT) ;
use-project /adk : ../../ ;


exe http_queuing_service
    : http_queuing_service.cpp
      ../..//adk
    : <include>../
      <cxxflags>-g3
      <threading>multi
      <implicit-dependency>/boost//headers
      <debug-symbols>on
    : <include>../
    ;
